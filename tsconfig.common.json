{
  "extends": ["@tsconfig/strictest", "@tsconfig/node22/tsconfig.json"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,

    "outDir": "common-ts-dist",
    "tsBuildInfoFile": "common-ts-dist/tsconfig.tsbuildinfo",

    // https://nodejs.org/api/typescript.html
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
  },
  "include": [
    "src/common/**/*",
  ],
  // tests are run by vitest from the sources; don't emit them into the build output,
  // or vitest would discover and run the compiled copies too
  "exclude": [
    "src/common/**/*.test.ts",
  ],
}